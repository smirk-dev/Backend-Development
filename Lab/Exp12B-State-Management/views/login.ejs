<%- include('partials/header') %>

<section class="card">
  <h1>Login</h1>
  <p class="lede">
    A successful login sets <code>req.session.user</code> on the server and sends back
    only a signed session ID in the <code>connect.sid</code> cookie.
  </p>

  <form action="/login" method="post" class="stack">
    <label>
      Username
      <input type="text" name="username" required autofocus autocomplete="username">
    </label>

    <label>
      Password
      <input type="password" name="password" required autocomplete="current-password">
    </label>

    <button type="submit">Log in</button>
  </form>

  <p class="muted">No account yet? <a href="/register">Register</a>.</p>
</section>

<%- include('partials/footer') %>
