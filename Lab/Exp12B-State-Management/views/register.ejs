<%- include('partials/header') %>

<section class="card">
  <h1>Register</h1>
  <p class="lede">
    Pick a username and a password of at least 6 characters. The password is hashed
    with bcrypt before it is written to <code>data/users.json</code> — the plain text
    is never stored.
  </p>

  <form action="/register" method="post" class="stack">
    <label>
      Username
      <input type="text" name="username" required autofocus autocomplete="username">
    </label>

    <label>
      Password
      <input type="password" name="password" required minlength="6" autocomplete="new-password">
    </label>

    <label>
      Confirm password
      <input type="password" name="confirm" required minlength="6" autocomplete="new-password">
    </label>

    <button type="submit">Create account</button>
  </form>

  <p class="muted">Already registered? <a href="/login">Log in</a>.</p>
</section>

<%- include('partials/footer') %>
