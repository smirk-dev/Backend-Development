<!DOCTYPE html>
<html>
<head>
    <title>Students</title>
</head>
<body>
    <h1>All Students</h1>
    <ul>
        <% students.forEach(student => { %>
            <li><strong><%= student.name %></strong> — <%= student.branch %></li>
        <% }); %>
    </ul>
    <a href="/">Back to Home</a>
</body>
</html>
